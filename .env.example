# Leave DATABASE_URL unset to use local SQLite at data/lld.db
# DATABASE_URL=postgres://user:password@host:5432/dbname
PORT=5174
PROJECTS_DIR=./projects

# Optional: set to run the metadata store contract suite against Postgres too.
#
# WARNING: the contract suite DELETES every row in the projects table before
# each test. This must point at a throwaway database — a separate Neon branch
# or a dedicated *_test database. Never point it at the same database as
# DATABASE_URL.
# TEST_DATABASE_URL=postgres://user:password@host:5432/dbname_test
